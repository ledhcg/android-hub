{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift run adbctl:*)",
      "Bash(scripts/fetch-scrcpy-server.sh)",
      "Bash(scripts/build-app.sh:*)",
      "Bash(gitleaks:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)"
    ]
  }
}
